# AlgoStyle Backend Configuration
# Copy this to .env and customize for your environment

# Environment: development, staging, or production
ENVIRONMENT=development

# CORS Origins (comma-separated for dev/staging)
# For production, these are hardcoded in config.py for security
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://192.168.1.71:8000

# CORS Settings
CORS_CREDENTIALS=true
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH
CORS_HEADERS=*
