# AlgoStyle Backend Configuration
# Copy this to .env and fill in ALL required values.
# Required fields have no default — the app will refuse to start without them.

# ── Environment ────────────────────────────────────────────────────────────
# development | staging | production
ENVIRONMENT=development

# ── Database (REQUIRED) ────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://<user>:<password>@<host>:5432/<dbname>

# ── Google Gemini API (REQUIRED) ───────────────────────────────────────────
GOOGLE_API_KEY=your_google_api_key_here

# ── LLM_project service (optional — leave empty to use mock fallback) ──────
LLM_API_URL=http://localhost:8001

# ── Neo4j graph database (optional — leave empty to disable) ───────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=neo4j

# ── CORS Origins ───────────────────────────────────────────────────────────
# Development / staging: comma-separated list of allowed origins (REQUIRED in dev).
# Production: CORS_ORIGINS is ignored — hardcoded secure domains are used instead.
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://192.168.x.x:8081

# Advanced CORS overrides (defaults are fine for most cases)
CORS_CREDENTIALS=true
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH
CORS_HEADERS=*
